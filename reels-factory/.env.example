# Bu dosyayı ".env" adıyla kopyalayın ve yalnızca kullanacağınız anahtarları doldurun.
# .env dosyası git'e eklenmez; anahtarlar asla kaynak koda veya log dosyalarına yazılmaz.

# Tam otonom mod (konu + araştırma + senaryo) — Claude API
ANTHROPIC_API_KEY=

# Seslendirme (isteğe bağlı; varsayılan edge-tts anahtar gerektirmez)
ELEVENLABS_API_KEY=

# Stok video / fotoğraf (Pexels lisansı: ücretsiz ticari kullanım)
PEXELS_API_KEY=

# Yapay zekâ görsel üretimi: Hugging Face (ücretsiz hesap, küçük aylık kota; FLUX.1-schnell) veya OpenAI
HF_TOKEN=
OPENAI_API_KEY=

# Yapay zekâ görsel/video üretimi (Replicate üzerindeki modeller)
REPLICATE_API_TOKEN=

# Stok video/fotoğraf (Pixabay lisansı: ücretsiz ticari kullanım)
PIXABAY_API_KEY=

# Yayın (uygulamadaki Yayın sayfası bunları kendisi yazar; kanal belirteçleri RF_<KANAL>_... adlarıyla eklenir)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude Code MCP sunucuları (isteğe bağlı; `python scripts/factory.py mcp` ya da Yayın → Ayarlar)
BRAVE_API_KEY=
CONTEXT7_API_KEY=
GITHUB_PAT=
POSTGRES_DSN=
