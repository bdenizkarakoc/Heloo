{#- Sabit katman: ilerleme göstergesi ve (varsa) kanal adı. -#}
{%- set c = brand.colors -%}
<template>
  <style>
    @font-face { font-family: "{{ brand.font_family }}"; src: url("assets/fonts/brand.ttf"); font-weight: 100 900; }
    #root { position: absolute; inset: 0; overflow: hidden; pointer-events: none; font-family: "{{ brand.font_family }}", sans-serif; }
    #ov-track { position: absolute; left: {{ margin }}px; top: {{ bar_y }}px; width: {{ W - 2 * margin }}px; height: 7px;
                border-radius: 999px; background: rgba(255,255,255,.20); overflow: hidden; }
    #ov-fill { position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: 999px;
               background: linear-gradient(90deg, {{ c.accent }}, {{ c.accent2 }}); transform-origin: 0 50%; }
    #ov-handle { position: absolute; left: {{ margin }}px; top: {{ bar_y + 22 }}px; font-size: 28px; font-weight: 700;
                 letter-spacing: .04em; color: rgba(255,255,255,.78); text-shadow: 0 2px 10px rgba(0,0,0,.6); }
  </style>
  <div id="root" data-composition-id="overlay" data-width="{{ W }}" data-height="{{ H }}">
    <div id="ov-track"><div id="ov-fill"></div></div>
{%- if handle %}
    <div id="ov-handle">{{ handle }}</div>
{%- endif %}
  </div>
  <script>
    (function () {
      const tl = gsap.timeline({ paused: true });
      tl.fromTo("#ov-fill", { scaleX: 0 }, { scaleX: 1, duration: {{ total }}, ease: "none" }, 0);
      window.__timelines["overlay"] = tl;
    })();
  </script>
</template>
