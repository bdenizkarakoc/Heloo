# Gizli bilgiler
.env
.env.*
!.env.example

# Bağımlılıklar ve önbellekler
node_modules/
__pycache__/
*.pyc
.venv/
.cache/

# Üretim çıktıları (büyük dosyalar)
projects/*
!projects/.gitkeep
output/videos/*
output/thumbnails/*
output/captions/*
output/cloud/
!output/**/.gitkeep
logs/*
!logs/.gitkeep

# Kullanıcının müzik kütüphanesi (lisans dosyası hariç)
assets/music/*
!assets/music/README.md
!assets/music/licenses.yaml
assets/sfx/*
!assets/sfx/README.md

# Uygulama durumu (otomatik mod ayarları)
config/app.json

# Video Stüdyosu (yüklenen videolar, öğrenilen stiller, çalışma klasörleri)
studio/
output/studio/
output/notes/

# Yayın: kanal ayarları/logolar ve onay kuyruğu (kullanıcı verisi)
channels/
publish/

# Graphify çıktıları (yerelde üretilir)
knowledge/
scripts/graphify-out/
graphify-out/
